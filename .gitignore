# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ingestion data
data/pdfs/*
!data/pdfs/.gitkeep
data/ingestion/*
!data/ingestion/.gitkeep

# Qdrant runtime data (was accidentally git-tracked; untracked in
# remediation/brevet-convergence-20260906 - see git history for the
# git rm --cached that removed it). This is live vector-store state,
# not source, and must never be bind-mounted into a git worktree.
qdrant_storage/

# Python (scripts/ingestion)
__pycache__/
*.pyc
.venv/
